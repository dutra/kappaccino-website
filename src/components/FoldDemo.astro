---
// A toy fold: two images of one source on opposite sides of a critical curve,
// drawn with their uncertainty. Each of a few hundred "model draws" nudges
// the critical curve (a small offset where the pair pins it, plus a tilt and
// a bend that grow away from the pair) and the source position. The images
// follow from the fold mapping beta_y = phi^2 / 2, where phi is the distance
// from the curve, so they stretch along the magnified direction and vanish
// when a draw pushes the source across the caustic. The band is the spread
// of the curves; the magnification of each draw is 1 / distance to its curve.
// Illustrative only, not a kappaccino model.
---

<div class="fold" data-fold-demo>
  <figure class="fig">
    <canvas aria-hidden="true"></canvas>
    <figcaption>
      <span class="key"><i class="sw sw-sq"></i>catalog positions of a fold pair</span>
      <span class="key"><i class="sw sw-cloud"></i>where the model puts the images</span>
      <span class="key"><i class="sw sw-curve"></i>critical curve, median with 68% and 95% bands</span>
    </figcaption>
  </figure>

  <div class="side">
    <p class="readout">
      <span>Magnification of one image</span>
      <strong data-mu>–</strong>
    </p>

    <svg class="spec" viewBox="0 0 320 96" role="img" aria-label="Spread of the magnification of one image across model draws, on a logarithmic axis.">
      <rect x="14" y="10" width="292" height="50" class="frame"></rect>
      <g data-rug></g>
      <line data-range class="range" y1="35" y2="35"></line>
      <circle data-median class="median" cy="35" r="5"></circle>
      {
        [3, 10, 30, 100].map((t) => {
          const x = 14 + (292 * Math.log(t / 2)) / Math.log(150);
          return (
            <g>
              <line x1={x} x2={x} y1="60" y2="64" class="tick" />
              <text x={x} y="76" text-anchor="middle" class="num">
                ×{t}
              </text>
            </g>
          );
        })
      }
      <text x="160" y="92" text-anchor="middle" class="axis">one tick per model draw; bar spans 68%</text>
    </svg>

    <p class="readout small">
      <span>Draws where the pair has merged away</span>
      <strong data-gone>–</strong>
    </p>

    <div class="controls">
      <label class="slider">
        <span>Distance to curve</span>
        <input type="range" min="0" max="1" step="0.001" value="0.5" data-slider aria-label="Distance of the image pair from the critical curve" />
      </label>
      <label class="slider">
        <span>Model uncertainty</span>
        <input type="range" min="0.3" max="2" step="0.01" value="1" data-unc aria-label="Size of the model uncertainty" />
      </label>
      <button type="button" data-reroll title="Draw a new set of models">Re-roll</button>
      <button type="button" data-pause aria-pressed="false">Pause</button>
    </div>
  </div>
</div>

<style>
  .fold {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 44px);
    align-items: center;
    margin-top: 34px;
  }
  .fig {
    margin: 0;
    display: grid;
    gap: 12px;
  }
  canvas {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: block;
    border-radius: 14px;
    border: 1px solid var(--line-strong);
    background: radial-gradient(120% 120% at 30% 20%, #14111f, #07060b 70%);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .sw {
    display: inline-block;
    flex: none;
  }
  .sw-sq {
    width: 9px;
    height: 9px;
    border: 1.5px solid #fff;
  }
  .sw-cloud {
    width: 14px;
    height: 8px;
    border-radius: 50%;
    background: rgba(242, 200, 145, 0.75);
  }
  .sw-curve {
    width: 18px;
    height: 8px;
    background: linear-gradient(rgba(143, 199, 255, 0.3), rgba(143, 199, 255, 0.3)) center / 100% 100% no-repeat;
    border-top: 0;
    position: relative;
  }
  .sw-curve::after {
    content: '';
    position: absolute;
    inset: 3px 0 auto;
    border-top: 2px solid var(--arc);
  }
  .side {
    display: grid;
    gap: 12px;
    font-size: 13.5px;
    color: var(--muted);
  }
  .readout {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    color: var(--ink-soft);
  }
  .readout strong {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.15rem;
    color: var(--arc);
    white-space: nowrap;
  }
  .readout.small strong {
    font-size: 1rem;
    color: var(--crema-bright);
  }
  .spec {
    width: 100%;
    height: auto;
    display: block;
  }
  .frame {
    fill: rgba(20, 17, 26, 0.7);
    stroke: var(--line);
  }
  .range {
    stroke: var(--arc);
    stroke-width: 4;
    stroke-linecap: round;
  }
  .median {
    fill: #fff;
    stroke: var(--arc);
    stroke-width: 2;
  }
  .fold :global(.rug) {
    stroke: var(--arc);
    stroke-width: 1;
    opacity: 0.3;
  }
  .tick {
    stroke: var(--line-strong);
  }
  .num,
  .axis {
    fill: var(--muted);
    font-size: 10px;
    font-family: var(--font-body);
  }
  .num {
    font-family: var(--font-mono);
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(20, 17, 26, 0.7);
  }
  .slider {
    display: grid;
    grid-template-columns: 9.5em 1fr;
    align-items: center;
    gap: 10px;
    color: var(--ink-soft);
    flex: 1 1 100%;
  }
  .slider input {
    min-width: 60px;
    width: 100%;
    accent-color: var(--crema);
  }
  button {
    font: inherit;
    color: var(--ink-soft);
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 5px 12px;
    cursor: pointer;
  }
  button:hover {
    border-color: var(--crema);
    color: var(--ink);
  }
  @media (max-width: 820px) {
    .fold {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { mulberry32 } from '../lib/field';

  const SVG_NS = 'http://www.w3.org/2000/svg';
  const K = 360; // model draws
  const N_RUG = 90;
  const PHI_MIN = 0.09; // closest half-separation of the pair
  const PHI_MAX = 0.5;
  const SKEW = 0.35; // the stretched direction is not perpendicular to the curve
  const ROT = -0.5; // tilt of the whole scene, radians
  const VIEW = 1.9; // field width in toy units
  const MU0 = 3; // magnification = MU0 / distance to the curve
  const SWEEP_PERIOD = 18000;
  const IDLE_AFTER = 3500;
  const XS = 57; // samples along the curve
  const X_SPAN = 1.6;

  const base = (x: number) => 0.2 * x * x;

  function init(root: HTMLElement) {
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const canvas = $<HTMLCanvasElement>('canvas');
    const ctx = canvas.getContext('2d')!;
    const slider = $<HTMLInputElement>('[data-slider]');
    const uncSlider = $<HTMLInputElement>('[data-unc]');
    const muOut = $<HTMLElement>('[data-mu]');
    const goneOut = $<HTMLElement>('[data-gone]');
    const pauseBtn = $<HTMLButtonElement>('[data-pause]');
    const rangeEl = $<SVGLineElement>('[data-range]');
    const medianEl = $<SVGCircleElement>('[data-median]');
    const rugG = $<SVGGElement>('[data-rug]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const rugs = Array.from({ length: N_RUG }, () => {
      const l = document.createElementNS(SVG_NS, 'line');
      l.setAttribute('class', 'rug');
      l.setAttribute('y1', '14');
      l.setAttribute('y2', '56');
      rugG.appendChild(l);
      return l;
    });

    // Per-draw unit Gaussians: curve offset, tilt, bend; source x, y; catalog noise for both images.
    const G = 9;
    const g = new Float32Array(K * G);
    let seed = 1234;
    function roll() {
      const rnd = mulberry32(seed);
      for (let i = 0; i < g.length; i++) g[i] = Math.sqrt(-2 * Math.log(1 - rnd())) * Math.cos(2 * Math.PI * rnd());
    }

    let u = 0.5;
    const phiOf = (v: number) => PHI_MIN * Math.pow(PHI_MAX / PHI_MIN, v);

    const col = new Float32Array(K);
    const lo95 = new Float32Array(XS);
    const lo68 = new Float32Array(XS);
    const med = new Float32Array(XS);
    const hi68 = new Float32Array(XS);
    const hi95 = new Float32Array(XS);
    const mus = new Float32Array(K);

    function draw() {
      const w = canvas.width;
      const h = canvas.height;
      if (!w) return;
      const dpr = w / (canvas.clientWidth || w);
      const S = w / VIEW;
      const cr = Math.cos(ROT);
      const sr = Math.sin(ROT);
      const X = (x: number, y: number) => w / 2 + S * (x * cr - y * sr);
      const Y = (x: number, y: number) => h / 2 - S * (x * sr + y * cr);

      const phi0 = phiOf(u);
      const unc = Number(uncSlider.value);
      const curve = (k: number, x: number) => base(x) + unc * (0.018 * g[k * G] + 0.13 * g[k * G + 1] * x + 0.14 * g[k * G + 2] * x * x);

      ctx.clearRect(0, 0, w, h);

      // Critical curve: percentiles of the draws at each point along it.
      for (let i = 0; i < XS; i++) {
        const x = -X_SPAN + (2 * X_SPAN * i) / (XS - 1);
        for (let k = 0; k < K; k++) col[k] = curve(k, x);
        col.sort();
        lo95[i] = col[Math.round(0.025 * (K - 1))];
        lo68[i] = col[Math.round(0.16 * (K - 1))];
        med[i] = col[Math.round(0.5 * (K - 1))];
        hi68[i] = col[Math.round(0.84 * (K - 1))];
        hi95[i] = col[Math.round(0.975 * (K - 1))];
      }
      const xAt = (i: number) => -X_SPAN + (2 * X_SPAN * i) / (XS - 1);
      const bandPath = (lo: Float32Array, hi: Float32Array) => {
        ctx.beginPath();
        for (let i = 0; i < XS; i++) ctx[i ? 'lineTo' : 'moveTo'](X(xAt(i), hi[i]), Y(xAt(i), hi[i]));
        for (let i = XS - 1; i >= 0; i--) ctx.lineTo(X(xAt(i), lo[i]), Y(xAt(i), lo[i]));
        ctx.closePath();
      };
      ctx.fillStyle = 'rgba(143, 199, 255, 0.13)';
      bandPath(lo95, hi95);
      ctx.fill();
      ctx.fillStyle = 'rgba(143, 199, 255, 0.22)';
      bandPath(lo68, hi68);
      ctx.fill();
      ctx.strokeStyle = '#8fc7ff';
      ctx.lineWidth = 2 * dpr;
      ctx.beginPath();
      for (let i = 0; i < XS; i++) ctx[i ? 'lineTo' : 'moveTo'](X(xAt(i), med[i]), Y(xAt(i), med[i]));
      ctx.stroke();

      // Catalog positions of the pair, from the unperturbed fold.
      const ax = SKEW * phi0;
      const ay = base(ax) + phi0;
      const bx = -SKEW * phi0;
      const by = base(bx) - phi0;

      // Image positions and magnification across the draws.
      const betaY = (phi0 * phi0) / 2;
      let gone = 0;
      ctx.fillStyle = 'rgba(242, 200, 145, 0.4)';
      const r = 2 * dpr;
      for (let k = 0; k < K; k++) {
        const o = k * G;
        const by2 = betaY + unc * 0.011 * g[o + 4];
        mus[k] = Math.min(MU0 / Math.max(Math.abs(ay - curve(k, ax)), 1e-3), 999);
        if (by2 <= 0) {
          gone++;
          continue;
        }
        const phi = Math.sqrt(2 * by2);
        const xs = unc * 0.012 * g[o + 3];
        for (let s = 1; s >= -1; s -= 2) {
          const j = s > 0 ? 5 : 7;
          const px = xs + s * SKEW * phi + 0.008 * g[o + j];
          const py = curve(k, px) + s * phi + 0.008 * g[o + j + 1];
          ctx.beginPath();
          ctx.arc(X(px, py), Y(px, py), r, 0, 2 * Math.PI);
          ctx.fill();
        }
      }

      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 1.6 * dpr;
      const q = 5 * dpr;
      ctx.strokeRect(X(ax, ay) - q, Y(ax, ay) - q, 2 * q, 2 * q);
      ctx.strokeRect(X(bx, by) - q, Y(bx, by) - q, 2 * q, 2 * q);

      // Magnification spread.
      const mx = (m: number) => 14 + (292 * Math.log(Math.min(Math.max(m, 2), 300) / 2)) / Math.log(150);
      for (let i = 0; i < N_RUG; i++) {
        const x = mx(mus[i * 4]).toFixed(1);
        rugs[i].setAttribute('x1', x);
        rugs[i].setAttribute('x2', x);
      }
      const sorted = mus.slice().sort();
      const p16 = sorted[Math.round(0.16 * (K - 1))];
      const p50 = sorted[Math.round(0.5 * (K - 1))];
      const p84 = sorted[Math.round(0.84 * (K - 1))];
      rangeEl.setAttribute('x1', mx(p16).toFixed(1));
      rangeEl.setAttribute('x2', mx(p84).toFixed(1));
      medianEl.setAttribute('cx', mx(p50).toFixed(1));
      const f = (m: number) => (m >= 100 ? '100+' : m < 10 ? m.toFixed(1) : m.toFixed(0));
      muOut.textContent = `×${f(p50)} (${f(p16)}–${f(p84)})`;
      goneOut.textContent = `${Math.round((100 * gone) / K)}%`;
      slider.value = u.toFixed(3);
    }

    let paused = reduceMotion;
    let visible = false;
    let lastInput = -Infinity;
    let phase = Math.PI / 2; // u = 0.5 - 0.5 cos(phase)
    let last = 0;
    let raf = 0;

    function frame(now: number) {
      raf = 0;
      const dt = Math.min(now - last, 100);
      last = now;
      if (!paused && now - lastInput > IDLE_AFTER) {
        phase += (2 * Math.PI * dt) / SWEEP_PERIOD;
        u = 0.5 - 0.5 * Math.cos(phase);
        draw();
      }
      schedule();
    }
    function schedule() {
      if (!raf && visible && !paused) {
        raf = requestAnimationFrame((t) => {
          if (!last) last = t;
          frame(t);
        });
      }
    }
    function setPaused(p: boolean) {
      paused = p;
      pauseBtn.textContent = p ? 'Play' : 'Pause';
      pauseBtn.setAttribute('aria-pressed', String(p));
      if (!p) {
        last = 0;
        lastInput = -Infinity;
        schedule();
      }
    }

    slider.addEventListener('input', () => {
      u = Number(slider.value);
      const rising = Math.sin(phase) >= 0;
      const a = Math.acos(1 - 2 * u);
      phase = rising ? a : 2 * Math.PI - a;
      lastInput = performance.now();
      draw();
    });
    uncSlider.addEventListener('input', draw);
    $('[data-reroll]').addEventListener('click', () => {
      seed = (seed * 1664525 + 1013904223) | 0;
      roll();
      draw();
    });
    pauseBtn.addEventListener('click', () => setPaused(!paused));

    new ResizeObserver(() => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const pw = Math.round(canvas.clientWidth * dpr);
      const ph = Math.round(canvas.clientHeight * dpr);
      if (pw && (pw !== canvas.width || ph !== canvas.height)) {
        canvas.width = pw;
        canvas.height = ph;
        draw();
      }
    }).observe(canvas);

    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      last = 0;
      schedule();
    }).observe(root);

    roll();
    setPaused(paused);
    draw();
  }

  document.querySelectorAll<HTMLElement>('[data-fold-demo]').forEach(init);
</script>
