    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }
</style>

<script>
  const deck = document.querySelector<HTMLElement>('[data-deck]')!;
  const slides = [...deck.querySelectorAll<HTMLElement>('.slide')];
  const bar = document.querySelector<HTMLElement>('[data-bar]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  let current = 0;

  function fit() {
    const k = Math.min(window.innerWidth / 1280, window.innerHeight / 720);
    for (const s of slides) s.style.zoom = String(k);
  }

  function show(i: number) {
    current = Math.max(0, Math.min(slides.length - 1, i));
    slides.forEach((s, n) => s.classList.toggle('active', n === current));
    bar.style.width = `${((current + 1) / slides.length) * 100}%`;
    count.textContent = `${current + 1} / ${slides.length}`;
    history.replaceState(null, '', `#${current + 1}`);
  }

  window.addEventListener('keydown', (ev) => {
    if (ev.metaKey || ev.ctrlKey || ev.altKey) return;
    // Leave the keys alone while a demo control has focus.
    const t = ev.target as HTMLElement;
    if (t.closest('input, button, select, textarea, canvas')) {
      if (ev.key === 'Escape') t.blur();
      return;
    }
    switch (ev.key) {
      case 'ArrowRight':
      case 'ArrowDown':
      case 'PageDown':
      case ' ':
        show(current + 1);
        break;
      case 'ArrowLeft':
      case 'ArrowUp':
      case 'PageUp':
        show(current - 1);
        break;
      case 'Home':
        show(0);
        break;
      case 'End':
        show(slides.length - 1);
        break;
      case 'f':
      case 'F':
        if (document.fullscreenElement) document.exitFullscreen();
        else document.documentElement.requestFullscreen();
        break;
      default:
        return;
    }
    ev.preventDefault();
  });

  window.addEventListener('resize', fit);
  window.addEventListener('hashchange', () => show((Number(location.hash.slice(1)) || 1) - 1));
  fit();
  show((Number(location.hash.slice(1)) || 1) - 1);
</script>
