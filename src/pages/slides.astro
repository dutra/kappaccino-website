---
// Slide deck for talks. It reuses the live demos from the landing page.
// Every slide is laid out on a fixed 1280 x 720 stage that is scaled to fit
// the window. Keys: arrows, PageUp/PageDown or space to move, Home/End to
// jump, F for fullscreen.
import { Code } from 'astro:components';
import katex from 'katex';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import LensToy from '../components/LensToy.astro';
import FoldDemo from '../components/FoldDemo.astro';
import GrfDemo from '../components/GrfDemo.astro';
import GpDemo from '../components/GpDemo.astro';
import ScalingDemo from '../components/ScalingDemo.astro';

const tex = (s: string, display = false) => katex.renderToString(s, { displayMode: display, throwOnError: true });

const contributions = [
  {
    glyph: '∇',
    title: 'Gradient-based inference',
    body: 'Implemented in JAX and NumPyro. Automatic differentiation and just-in-time compilation enable Hamiltonian Monte Carlo over several hundred parameters.',
  },
  {
    glyph: 'C',
    title: 'Structured positional uncertainties',
    body: 'Measurement errors, unmodeled mass, and image-plane displacements are modeled separately and inferred jointly with the lens.',
  },
  {
    glyph: 'σ★',
    title: 'Hierarchical member population',
    body: 'Every member galaxy may deviate from the luminosity scaling relations while constraining the population parameters.',
  },
];

const components = [
  { sym: '\\psi_h', title: 'Cluster-scale halos', body: 'A small number of dark-matter halos with dPIE or elliptical NFW profiles.' },
  { sym: '\\psi_s', title: 'Member-galaxy subhalos', body: 'One dPIE subhalo per cluster member, tied to its luminosity through scaling relations.' },
  { sym: '\\psi_{\\rm ext}', title: 'External shear', body: 'The leading-order tidal contribution of mass outside the modeled region.' },
  { sym: '\\delta\\psi', title: 'Unmodeled mass', body: 'A non-parametric perturbation for structure the parametric components do not capture.' },
];

const errors = [
  {
    sym: '\\mathbf C_{\\rm meas}',
    eq: '\\mathbf C_{ii,\\rm meas}=\\sigma_{{\\rm meas},i}^2\\,\\mathbf A_i\\mathbf A_i^{\\rm T}',
    title: 'Measurement uncertainty',
    body: 'Uncorrelated scatter in the catalogued positions, propagated to the source plane through the lensing Jacobian. Its amplitude is inferred rather than fixed in advance.',
    tag: 'uncorrelated',
  },
  {
    sym: '\\mathbf C_{\\rm GRF}',
    eq: '\\mathbf C_{ij,\\rm GRF}=w_iw_j\\,\\mathbf K_\\alpha(\\boldsymbol\\theta_i-\\boldsymbol\\theta_j)',
    title: 'Unmodeled mass',
    body: 'Deflection perturbations from a Gaussian random field. They scale with source redshift, enter without a Jacobian factor, and remain finite on critical curves.',
    tag: 'contributes mass',
  },
  {
    sym: '\\mathbf C_{\\rm GP}',
    eq: '\\mathbf C_{ij,\\rm GP}=\\sigma_{\\rm GP}^2\\,e^{-|\\boldsymbol\\theta_i-\\boldsymbol\\theta_j|^2/2\\ell_{\\rm GP}^2}\\,\\mathbf A_i\\mathbf A_j^{\\rm T}',
    title: 'Image-plane displacements',
    body: 'Correlated offsets unrelated to the cluster mass: line-of-sight structure, feature matching along arcs, and residual astrometric distortions.',
    tag: 'no mass',
  },
];

const pipeline = [
  { step: '1', title: 'Input', body: 'Image and member catalogs; model specified in Python or imported from a Lenstool parameter file.' },
  { step: '2', title: 'Optimisation', body: 'Multi-start gradient-based optimisation locates the posterior mode.' },
  { step: '3', title: 'Member classification', body: 'Nearby members are evaluated exactly; distant members through a far-field expansion.' },
  { step: '4', title: 'Sampling', body: 'NUTS jointly samples lens parameters, member deviations, hyperparameters, and source positions.' },
  { step: '5', title: 'Output', body: 'Posterior samples, convergence diagnostics, and lensing maps.' },
];

const installCode = `git clone https://github.com/dutra/kappaccino.git
cd kappaccino
python -m pip install -e .`;
---

<Base title="kappaccino · slides" description="Slides introducing kappaccino, a Bayesian cluster strong-lensing code written in JAX.">
  <div class="deck" data-deck>
    <!-- 1 · title -->
    <div class="slide title-slide">
      <div class="title-text">
        <p class="brand"><Logo size={44} /><span><i>κ</i>appaccino</span></p>
        <h1>A differentiable Bayesian framework for cluster strong-lens modeling</h1>
        <p class="lede">
          Correlated positional uncertainties, unmodeled mass, and hierarchical member scaling relations.
        </p>
        <p class="authors">
          Isaque Dutra<sup>1</sup>, Priyamvada Natarajan<sup>1</sup>, Colin J. Burke<sup>2</sup><br />
          <span><sup>1</sup>Yale University · <sup>2</sup>University of North Texas</span>
        </p>
      </div>
      <div class="title-toy"><LensToy formal /></div>
    </div>

    <!-- 2 · contributions -->
    <div class="slide">
      <p class="eyebrow">Overview</p>
      <h2>Motivation and contributions</h2>
      <p class="lede">
        Current cluster catalogs contain hundreds of multiple images and hundreds of member galaxies. Conventional parametric
        models fix the positional uncertainty in advance and fit only a few members individually.
      </p>
      <ul class="cards three">
        {
          contributions.map((c) => (
            <li>
              <span class="glyph">{c.glyph}</span>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- 3 · lens model -->
    <div class="slide">
      <p class="eyebrow">Lens model</p>
      <h2>Parametric mass components with a non-parametric perturbation</h2>
      <div class="big-eq" set:html={tex('\\psi(\\boldsymbol\\theta)=\\sum_{h}\\psi_h(\\boldsymbol\\theta)+\\sum_{s}\\psi_s(\\boldsymbol\\theta)+\\psi_{\\rm ext}(\\boldsymbol\\theta)+\\delta\\psi(\\boldsymbol\\theta)', true)} />
      <ul class="cards four">
        {
          components.map((c) => (
            <li>
              <span class="sym" set:html={tex(c.sym)} />
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="foot">
        The lensing potential{' '}<span set:html={tex('\\psi')} />{' '}determines the deflection{' '}
        <span set:html={tex('\\boldsymbol\\alpha=\\nabla\\psi')} />. All components are inferred jointly.
      </p>
    </div>

    <!-- 4 · likelihood -->
    <div class="slide">
      <p class="eyebrow">Likelihood</p>
      <h2>A local image-plane likelihood</h2>
      <p class="lede">
        Predicting image positions requires all roots of the lens equation, which is costly and not differentiable. The
        inverse mapping requires a single deflection evaluation per image.
      </p>
      <div class="explain">
        <div class="eqs">
          <div class="big-eq" set:html={tex('\\boldsymbol\\beta_i=\\boldsymbol\\theta_i-\\boldsymbol\\alpha(\\boldsymbol\\theta_i),\\qquad \\boldsymbol F_i=\\boldsymbol\\beta_i-\\boldsymbol\\beta_k', true)} />
          <div class="big-eq" set:html={tex('\\mathcal L_{\\rm pos}(\\boldsymbol\\Theta)\\simeq\\mathcal N\\!\\big(\\boldsymbol F;\\,\\mathbf C\\big)\\prod_{i}\\big\\langle|\\det\\mathbf A_i|\\big\\rangle', true)} />
        </div>
        <ul class="points">
          <li>
            <span set:html={tex('\\boldsymbol F_i')} />{' '}is the source-plane residual of image{' '}<span set:html={tex('i')} />{' '}
            with respect to the source position{' '}<span set:html={tex('\\boldsymbol\\beta_k')} />{' '}of its family, which is
            sampled jointly with the lens.
          </li>
          <li>
            Marginalising over the true image positions, to first order around the measured ones, yields a single Gaussian in{' '}
            <span set:html={tex('\\boldsymbol F')} />{' '}with covariance{' '}<span set:html={tex('\\mathbf C')} />.
          </li>
          <li>
            The determinant accounts for the change of area between planes. Without it, a source-plane likelihood favours
            models that place critical curves near the images.
          </li>
          <li>The lens equation is never solved, and the likelihood is differentiable in all parameters.</li>
        </ul>
      </div>
    </div>

    <!-- 5 · critical curves: concept -->
    <div class="slide">
      <p class="eyebrow">Uncertainty propagation</p>
      <h2>Positional uncertainty near critical curves</h2>
      <div class="explain">
        <div class="eqs">
          <div class="big-eq" set:html={tex('\\mathbf A_i=\\frac{\\partial\\boldsymbol\\beta}{\\partial\\boldsymbol\\theta}\\bigg|_{\\boldsymbol\\theta_i},\\qquad \\mu_i=\\frac{1}{|\\det\\mathbf A_i|}', true)} />
          <div class="big-eq" set:html={tex('\\mathbf C_{ii,\\rm meas}=\\sigma_{{\\rm meas},i}^2\\,\\mathbf A_i\\mathbf A_i^{\\rm T}', true)} />
        </div>
        <ul class="points">
          <li>
            On a critical curve one eigenvalue of the Jacobian{' '}<span set:html={tex('\\mathbf A')} />{' '}vanishes and the
            magnification{' '}<span set:html={tex('\\mu')} />{' '}diverges.
          </li>
          <li>
            A small perturbation of the deflection field displaces a nearby image by a large amount, mainly along the
            eigenvector of the smallest eigenvalue. Position uncertainties are therefore strongly anisotropic.
          </li>
          <li>
            Two models can reproduce an image position while placing the critical curve differently. The inferred
            magnification then differs far more than the position.
          </li>
          <li>
            The total covariance remains invertible where{' '}<span set:html={tex('\\mathbf A')} />{' '}is singular, so the
            likelihood never requires the inverse Jacobian.
          </li>
        </ul>
      </div>
    </div>

    <!-- 6 · critical curves: demonstration -->
    <div class="slide demo-slide">
      <p class="eyebrow">Uncertainty propagation · demonstration</p>
      <h2>Uncertainties on image positions and critical curves</h2>
      <p class="note">
        Points show the image positions predicted by an ensemble of model draws, and the band the corresponding critical curves.
        The uncertainty elongates along the arcs and the magnification interval widens as the source approaches the caustic.
        Illustrative parameters.
      </p>
      <FoldDemo formal />
    </div>

    <!-- 7 · covariance -->
    <div class="slide">
      <p class="eyebrow">Positional covariance</p>
      <h2>Three contributions to the positional covariance</h2>
      <div class="big-eq" set:html={tex('\\mathbf C=\\mathbf C_{\\rm meas}+\\mathbf C_{\\rm GRF}+\\mathbf C_{\\rm GP}', true)} />
      <ul class="cards three">
        {
          errors.map((e) => (
            <li>
              <div class="card-top">
                <h3>{e.title}</h3>
                <span class="tag">{e.tag}</span>
              </div>
              <div class="card-eq" set:html={tex(e.eq, true)} />
              <p>{e.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="foot">
        The amplitude and correlation scale of each term are inferred jointly with the lens model. The off-diagonal blocks,
        which arise only from the last two terms, describe correlations between images.
      </p>
    </div>

    <!-- 8 · random field: concept -->
    <div class="slide">
      <p class="eyebrow">Unmodeled mass</p>
      <h2>A Gaussian random field for unmodeled mass</h2>
      <div class="explain">
        <div class="eqs">
          <div class="big-eq" set:html={tex('P_\\kappa(k)=A_\\kappa\\left[1+\\left(\\frac{k}{k_{\\rm b}}\\right)^{\\gamma_\\kappa}\\right]^{-1},\\quad \\lambda_{\\rm b}=\\frac{2\\pi}{k_{\\rm b}}', true)} />
          <div class="big-eq" set:html={tex('\\sigma_{\\rm GRF}^2=\\frac{1}{\\pi}\\int_{k_{\\min}}^{k_{\\max}}\\frac{dk}{k}\\,P_\\kappa(k)', true)} />
        </div>
        <ul class="points">
          <li>
            The perturbation{' '}<span set:html={tex('\\delta\\psi')} />{' '}is a homogeneous, isotropic, zero-mean Gaussian
            random field, specified entirely by the power spectrum of its convergence{' '}<span set:html={tex('\\delta\\kappa')} />.
          </li>
          <li>
            The spectrum is flat on scales larger than{' '}<span set:html={tex('\\lambda_{\\rm b}')} />, as for randomly
            distributed compact clumps, and declines as{' '}<span set:html={tex('k^{-\\gamma_\\kappa}')} />{' '}on smaller scales.
          </li>
          <li>
            The amplitude is parameterised by the rms deflection per coordinate,{' '}<span set:html={tex('\\sigma_{\\rm GRF}')} />,
            in arcseconds.
          </li>
          <li>
            Images separated by much less than{' '}<span set:html={tex('\\lambda_{\\rm b}')} />{' '}are deflected almost
            identically. The field can displace a close pair, such as a fold pair, but cannot change its separation.
          </li>
          <li>The field contributes directly to the reconstructed mass and magnification maps.</li>
        </ul>
      </div>
    </div>

    <!-- 9 · random field: demonstration -->
    <div class="slide demo-slide">
      <p class="eyebrow">Unmodeled mass · demonstration</p>
      <h2>Realizations of the convergence perturbation</h2>
      <p class="note">
        A realization of{' '}<span set:html={tex('\\delta\\kappa')} />{' '}as the break scale{' '}
        <span set:html={tex('\\lambda_{\\rm b}')} />{' '}varies. Larger{' '}<span set:html={tex('\\lambda_{\\rm b}')} />{' '}
        produces coherent structure on larger angular scales. Illustrative parameters.
      </p>
      <GrfDemo formal />
    </div>

    <!-- 10 · image-plane GP: concept -->
    <div class="slide">
      <p class="eyebrow">Image-plane systematics</p>
      <h2>A Gaussian process for correlated image-plane displacements</h2>
      <div class="explain">
        <div class="eqs">
          <div class="big-eq" set:html={tex('\\mathbf C_{ij,\\rm GP}=\\sigma_{\\rm GP}^2\\exp\\!\\left(-\\frac{|\\boldsymbol\\theta_i-\\boldsymbol\\theta_j|^2}{2\\ell_{\\rm GP}^2}\\right)\\mathbf A_i\\mathbf A_j^{\\rm T}', true)} />
        </div>
        <ul class="points">
          <li>
            Some effects displace neighbouring images coherently without involving the cluster mass: line-of-sight structure,
            systematic offsets in matching features along extended arcs, and residual astrometric distortions.
          </li>
          <li>
            <span set:html={tex('\\sigma_{\\rm GP}')} />{' '}is the typical displacement of one image and{' '}
            <span set:html={tex('\\ell_{\\rm GP}')} />{' '}the angular scale over which displacements remain correlated. Both are
            inferred.
          </li>
          <li>
            Unlike the mass field, these displacements do not scale with source redshift, and they are propagated through the
            Jacobians, so they vanish along the stretched direction near a critical curve.
          </li>
          <li>
            These two differences allow the data to distinguish unmodeled cluster mass from image-plane errors, which add no
            mass to the reconstruction.
          </li>
        </ul>
      </div>
    </div>

    <!-- 11 · image-plane GP: demonstration -->
    <div class="slide demo-slide">
      <p class="eyebrow">Image-plane systematics · demonstration</p>
      <h2>Realizations of the displacement field</h2>
      <p class="note">
        A realization of the displacement field as the correlation length{' '}<span set:html={tex('\\ell_{\\rm GP}')} />{' '}
        varies. Images separated by less than{' '}<span set:html={tex('\\ell_{\\rm GP}')} />{' '}are displaced coherently; more
        distant images are displaced independently. Illustrative parameters.
      </p>
      <GpDemo formal />
    </div>

    <!-- 12 · members: concept -->
    <div class="slide">
      <p class="eyebrow">Member galaxies</p>
      <h2>Hierarchical scaling relations with individual deviations</h2>
      <div class="explain">
        <div class="eqs">
          <div class="big-eq" set:html={tex('\\begin{aligned}\\sigma_{0,g}&=\\sigma_\\star\\left(\\frac{L_g}{L_\\star}\\right)^{\\alpha_\\sigma}\\exp(s_\\sigma z_{\\sigma,g})\\\\[6pt] r_{{\\rm cut},g}&=r_{{\\rm cut},\\star}\\left(\\frac{L_g}{L_\\star}\\right)^{\\beta_r}\\exp(s_r z_{r,g})\\end{aligned}', true)} />
          <div class="big-eq" set:html={tex('M_g\\propto\\sigma_{0,g}^2\\,r_{{\\rm cut},g}', true)} />
        </div>
        <ul class="points">
          <li>
            The velocity dispersion and truncation radius of each member follow power laws in luminosity, relative to a
            reference galaxy{' '}<span set:html={tex('L_\\star')} />.
          </li>
          <li>
            Shared by the population:{' '}<span set:html={tex('\\sigma_\\star,\\ r_{{\\rm cut},\\star},\\ \\alpha_\\sigma,\\ \\beta_r')} />{' '}
            and the intrinsic scatters{' '}<span set:html={tex('s_\\sigma,\\ s_r')} />. Specific to each member: the deviations{' '}
            <span set:html={tex('z_{\\sigma,g},\\ z_{r,g}')} />.
          </li>
          <li>
            Conventional models fix members to the relations and fit a few influential galaxies independently. Those galaxies
            constrain the relations best, so that information is lost.
          </li>
          <li>
            Here every member deviates individually while remaining tied to the population, and all members jointly constrain
            the normalisation, slope, and intrinsic scatter.
          </li>
        </ul>
      </div>
    </div>

    <!-- 13 · members: demonstration -->
    <div class="slide demo-slide">
      <p class="eyebrow">Member galaxies · demonstration</p>
      <h2>Individual deviations about the mean relation</h2>
      <p class="note">
        Illustrative members scatter about the mean relation as the intrinsic scatter{' '}<span set:html={tex('s_\\sigma')} />{' '}
        varies, each with its own deviation. Select “Conventional” to compare with members fixed to the relation.
      </p>
      <ScalingDemo formal />
    </div>

    <!-- 14 · inference -->
    <div class="slide">
      <p class="eyebrow">Inference</p>
      <h2>Two-stage inference: optimisation, then sampling</h2>
      <p class="lede">
        Posterior sampling in several hundred dimensions is inefficient from an arbitrary starting point. The posterior mode is
        located first and used to initialise the sampler.
      </p>
      <ol class="cards five">
        {
          pipeline.map((p) => (
            <li>
              <span class="step">Step {p.step}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="foot">
        Far-field members:{' '}<span set:html={tex('\\boldsymbol\\alpha_{\\rm far}\\simeq\\boldsymbol G\\,\\boldsymbol w')} />, where{' '}
        <span set:html={tex('\\boldsymbol G')} />{' '}holds precomputed geometric factors and{' '}<span set:html={tex('\\boldsymbol w')} />{' '}
        coefficients that depend on the member parameters. Every member retains its individual deviation.
      </p>
    </div>

    <!-- 15 · availability -->
    <div class="slide">
      <p class="eyebrow">Availability</p>
      <h2>Code and documentation</h2>
      <div class="try">
        <div class="code"><Code code={installCode} lang="bash" theme="vitesse-dark" /></div>
        <ul class="links">
          <li><span>Code</span><a href="https://github.com/dutra/kappaccino">github.com/dutra/kappaccino</a></li>
          <li><span>Docs</span><a href="https://kappaccino.readthedocs.io/">kappaccino.readthedocs.io</a></li>
          <li><span>Site</span><a href="https://dutra.github.io/kappaccino-website/">dutra.github.io/kappaccino-website</a></li>
          <li><span>Paper</span>in preparation</li>
        </ul>
      </div>
      <p class="foot">Existing Lenstool parameter files can be imported directly as a starting model.</p>
    </div>
  </div>

  <div class="hud" aria-hidden="true">
    <span class="bar"><i data-bar></i></span>
    <span class="count" data-count></span>
  </div>
</Base>

<style>
  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
  }
  .deck {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .slide {
    display: none;
    width: 1280px;
    height: 720px;
    padding: 46px 64px 40px;
    flex-direction: column;
    justify-content: center;
    flex: none;
  }
  .demo-slide {
    justify-content: flex-start;
  }
  .slide.active {
    display: flex;
  }

  .eyebrow {
    margin-bottom: 10px;
  }
  h2 {
    font-size: 2.3rem;
    max-width: 28ch;
  }
  h3 {
    font-size: 1.4rem;
    font-weight: 600;
  }
  .lede {
    margin-top: 16px;
    max-width: 70ch;
    color: var(--ink-soft);
    font-size: 1.15rem;
    line-height: 1.55;
  }
  .foot {
    margin-top: 34px;
    color: var(--muted);
    font-size: 1rem;
  }

  /* ── title ── */
  .title-slide.active {
    flex-direction: row;
    align-items: center;
    gap: 56px;
  }
  .title-text {
    flex: 1;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-size: 1.9rem;
    font-weight: 600;
    margin-bottom: 34px;
  }
  .brand i {
    color: var(--crema);
    font-size: 1.12em;
  }
  h1 {
    font-size: 2.9rem;
    max-width: 19ch;
  }
  .authors {
    margin-top: 40px;
    color: var(--ink-soft);
    font-size: 1.1rem;
    line-height: 1.8;
  }
  .authors span {
    color: var(--muted);
    font-size: 0.98rem;
  }
  .title-toy {
    width: 320px;
    flex: none;
  }

  /* ── cards ── */
  .cards {
    list-style: none;
    padding: 0;
    margin: 36px 0 0;
    display: grid;
    gap: 18px;
  }
  .cards.three {
    grid-template-columns: repeat(3, 1fr);
  }
  .cards.five {
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
  }
  .cards li {
    padding: 30px 28px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-card);
  }
  .cards p {
    margin-top: 10px;
    color: var(--ink-soft);
    font-size: 1.08rem;
    line-height: 1.5;
  }
  .cards.five li {
    padding: 20px 18px;
  }
  .cards.five h3 {
    font-size: 1.15rem;
  }
  .cards.five p {
    font-size: 0.95rem;
  }
  .glyph {
    display: inline-grid;
    place-items: center;
    min-width: 46px;
    height: 46px;
    padding: 0 10px;
    margin-bottom: 18px;
    border-radius: 12px;
    background: rgba(224, 168, 104, 0.12);
    color: var(--crema-bright);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
  }
  .step {
    display: block;
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--crema);
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .sym {
    font-size: 1.3rem;
    color: var(--crema-bright);
  }
  .tag {
    flex: none;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--ink-soft);
  }

  /* ── equations and points ── */
  .big-eq {
    margin-top: 30px;
    padding: 22px 28px;
    border-radius: 14px;
    background: rgba(20, 17, 26, 0.75);
    border: 1px solid var(--line);
    font-size: 1.35rem;
  }
  .big-eq :global(.katex-display) {
    margin: 0;
  }
  .points {
    margin: 30px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 16px;
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 78ch;
  }
  .points li {
    padding-left: 18px;
    border-left: 2px solid var(--roast);
  }

  /* ── demo slides: fit the page components to the stage ── */
  .demo-slide :global(.fold),
  .demo-slide :global(.grf),
  .demo-slide :global(.gp),
  .demo-slide :global(.scal) {
    margin-top: 22px;
    flex: 1;
    min-height: 0;
  }
  .demo-slide :global(.cup-fig) {
    width: 400px;
